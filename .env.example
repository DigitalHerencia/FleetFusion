# Runtime uses Neon's pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Prisma migrations should use Neon's direct connection string.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Clerk variables are populated when the authentication issue is configured.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SIGNING_SECRET=""

# Optional provider integrations. Missing values leave public demo routes available.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
BLOB_READ_WRITE_TOKEN=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
SENDGRID_WEBHOOK_VERIFICATION_KEY=""
HUGGINGFACE_ACCESS_TOKEN=""
HUGGINGFACE_TEXT_MODEL="HuggingFaceH4/zephyr-7b-beta"
