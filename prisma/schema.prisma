generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── FleetFusion: fleet · dispatch · compliance ─────────
enum DriverStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}
enum VehicleStatus {
  ACTIVE
  IN_SHOP
  OUT_OF_SERVICE
  RETIRED
}
enum VehicleType {
  TRACTOR
  TRAILER
  STRAIGHT_TRUCK
}
enum LoadStatus {
  DRAFT
  BOOKED
  DISPATCHED
  AT_PICKUP
  IN_TRANSIT
  AT_DELIVERY
  DELIVERED
  CANCELED
}
enum LoadStopType {
  PICKUP
  DELIVERY
}
enum ComplianceSubjectType {
  ORGANIZATION
  DRIVER
  VEHICLE
}
enum ComplianceItemType {
  CDL
  MEDICAL_CARD
  REGISTRATION
  INSURANCE
  ANNUAL_INSPECTION
  IRP_CAB_CARD
  IFTA_LICENSE
  UCR
  OPERATING_AUTHORITY
  OTHER
}

model Driver {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  membershipId   String? @unique @db.Uuid

  firstName  String
  lastName   String
  phone      String?
  email      String?
  status     DriverStatus @default(ACTIVE)
  hiredAt    DateTime?    @db.Date
  archivedAt DateTime?    @db.Timestamptz(6)
  version    Int          @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership?  @relation("DriverMembership", fields: [membershipId], references: [id], onDelete: SetNull)

  loads           Load[]           @relation("LoadDriver")
  complianceItems ComplianceItem[] @relation("ComplianceDriver")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, status])
  @@index([organizationId, lastName, firstName])
}

model Vehicle {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  unitNumber String
  type       VehicleType   @default(TRACTOR)
  status     VehicleStatus @default(ACTIVE)
  vin        String?
  plate      String?
  plateState String?       @db.Char(2)
  make       String?
  model      String?
  year       Int?
  archivedAt DateTime?     @db.Timestamptz(6)
  version    Int           @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  loads           Load[]           @relation("LoadVehicle")
  complianceItems ComplianceItem[] @relation("ComplianceVehicle")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, unitNumber])
  @@index([organizationId, status])
}

model Load {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @db.Uuid
  customerAccountId String? @db.Uuid
  driverId          String? @db.Uuid
  vehicleId         String? @db.Uuid

  number          Int
  referenceNumber String?
  status          LoadStatus @default(DRAFT)
  rate            Decimal    @default(0) @db.Decimal(19, 4)
  currency        String     @default("USD") @db.Char(3)
  miles           Int?
  notes           String?
  podReceivedAt   DateTime?  @db.Timestamptz(6)
  deliveredAt     DateTime?  @db.Timestamptz(6)
  archivedAt      DateTime?  @db.Timestamptz(6)
  version         Int        @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     CrmAccount?  @relation("LoadCustomer", fields: [customerAccountId], references: [id], onDelete: SetNull)
  driver       Driver?      @relation("LoadDriver", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?     @relation("LoadVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)

  stops    LoadStop[]
  invoices Invoice[]  @relation("LoadInvoices")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, driverId, status])
  @@index([organizationId, customerAccountId])
}

model LoadStop {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  loadId         String @db.Uuid

  sequence     Int
  type         LoadStopType
  locationName String?
  address1     String?
  city         String
  state        String    @db.Char(2)
  postalCode   String?
  windowStart  DateTime? @db.Timestamptz(6)
  windowEnd    DateTime? @db.Timestamptz(6)
  arrivedAt    DateTime? @db.Timestamptz(6)
  departedAt   DateTime? @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  load         Load         @relation(fields: [loadId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([loadId, sequence])
  @@index([organizationId, loadId])
}

model ComplianceItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  driverId       String? @db.Uuid
  vehicleId      String? @db.Uuid
  assetId        String? @db.Uuid

  subjectType     ComplianceSubjectType
  type            ComplianceItemType
  title           String?
  referenceNumber String?
  issuedAt        DateTime? @db.Date
  expiresAt       DateTime? @db.Date
  archivedAt      DateTime? @db.Timestamptz(6)
  version         Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  driver       Driver?      @relation("ComplianceDriver", fields: [driverId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation("ComplianceVehicle", fields: [vehicleId], references: [id], onDelete: Cascade)
  asset        Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([organizationId, expiresAt])
  @@index([organizationId, subjectType, type])
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  BILLING
  SUPPORT
  CLIENT
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique
  email       String?
  displayName String?
  memberships Membership[]
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  memberships Membership[]
  drivers   Driver[]
  vehicles  Vehicle[]
  loads     Load[]
  loadStops LoadStop[]
  complianceItems ComplianceItem[]
  crmAccounts CrmAccount[]
  invoices Invoice[]
  assets Asset[]
  settings OrganizationSettings?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Membership {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid
  role           MembershipRole @default(MEMBER)
  status         MembershipStatus @default(ACTIVE)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  driver Driver? @relation("DriverMembership")
  createdAssets Asset[] @relation("AssetCreator")
  ownedCrmAccounts CrmAccount[] @relation("CrmAccountOwner")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([organizationId, userId])
  @@index([userId, status])
}

model OrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid
  timezone       String @default("UTC")
  locale         String @default("en-US")
  defaultCurrency String @default("USD") @db.Char(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CrmAccount {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  ownerMembershipId String? @db.Uuid
  name           String
  website        String?
  industry       String?
  status         String @default("ACTIVE")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerMembership Membership? @relation("CrmAccountOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  loads          Load[] @relation("LoadCustomer")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@index([organizationId, status])
}

model Invoice {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loads Load[] @relation("LoadInvoices")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Asset {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  createdByMembershipId String? @db.Uuid
  storageProvider String
  storageKey String
  filename String
  contentType String?
  byteSize BigInt @default(0)
  checksum String?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByMembership Membership? @relation("AssetCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  complianceItems ComplianceItem[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  @@unique([organizationId, storageKey])
}
